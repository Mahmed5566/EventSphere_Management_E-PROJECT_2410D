PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- AI Event Copilot (optional) -------------------------------------------
# Leave AI_PROVIDER empty to disable the copilot; the app will show a clear
# configuration message instead of inventing answers.
# Supported providers: openai | groq | openrouter | deepseek | mistral | together | gemini | custom
# AI_MODEL must be a model id that the selected provider actually supports.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Required only when AI_PROVIDER=custom (OpenAI-compatible endpoint base URL)
AI_BASE_URL=
AI_TIMEOUT_MS=15000
